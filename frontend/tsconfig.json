{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    // Vite does the bundling, so let TypeScript resolve imports the way a bundler does.
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // Type-only imports must say `import type`, so they're erased cleanly by the bundler.
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    // Vite builds the output; tsc only type-checks.
    "noEmit": true
  },
  "include": ["src", "vite.config.ts"]
}
