{
  "name": "email-scheduler-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Email scheduler API + BullMQ worker (ReachInbox assignment)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,worker -c blue,magenta \"npm:dev:api\" \"npm:dev:worker\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start:api": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "es:reindex": "tsx scripts/reindex-elasticsearch.ts",
    "load-test": "tsx scripts/load-test.ts",
    "prove:rate-limit": "tsx scripts/prove-rate-limit.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@bull-board/api": "6.21.3",
    "@bull-board/express": "6.21.3",
    "@elastic/elasticsearch": "8.19.2",
    "@prisma/client": "6.19.3",
    "bullmq": "5.81.5",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "5.3.0",
    "google-auth-library": "10.9.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "10.3.1",
    "pino": "9.14.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.5",
    "concurrently": "9.2.5",
    "pino-pretty": "13.2.0",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
