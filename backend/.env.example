# ---------------------------------------------------------------------------
# Email scheduler backend configuration.
# Copy to .env (cp .env.example .env) and fill in the blanks.
# Every value is validated at startup by src/config/env.ts; the process exits
# with a clear message if anything is missing or malformed.
# ---------------------------------------------------------------------------

# --- General ---------------------------------------------------------------
# development | test | production
NODE_ENV=development
# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- HTTP / URLs -------------------------------------------------------------
# Port the Express API listens on.
PORT=4000
# The browser always uses the frontend's address: the frontend server forwards /api, /auth,
# /admin and /health to this API, so both share one domain. Locally that's http://localhost:3000;
# when the app is shared through ngrok, set both URLs below to the ngrok URL
# (e.g. https://your-name.ngrok-free.dev) and update the Google and Slack redirect URIs to match.
# Public URL of the app (used for links, logs and the email Message-ID domain).
API_PUBLIC_URL=http://localhost:3000
# Where the dashboard runs; used for CORS and post-login redirects.
FRONTEND_URL=http://localhost:3000

# --- Auth --------------------------------------------------------------------
# Secret used to sign session JWTs and OAuth `state` values. Min 32 chars.
# Generate one with: openssl rand -hex 32
JWT_SECRET=
# Session lifetime, in seconds (default 7 days).
JWT_EXPIRES_IN_SECONDS=604800
# Enables POST /auth/dev-login (for Postman / load tests). Ignored when NODE_ENV=production.
ALLOW_DEV_LOGIN=true

# --- Datastores --------------------------------------------------------------
# Matches the postgres service in docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_scheduler?schema=public
# Matches the redis service in docker-compose.yml.
REDIS_URL=redis://localhost:6379
# Matches the elasticsearch service in docker-compose.yml.
ELASTICSEARCH_URL=http://localhost:9200
# Name of the index that stores searchable emails.
ELASTICSEARCH_INDEX=emails

# --- Google OAuth (login) ----------------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the OAuth client (goes through the frontend URL).
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Slack OAuth (rate-limit notifications) ----------------------------------
# From api.slack.com/apps -> your app -> Basic Information.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Slack requires HTTPS here, so use your ngrok URL, e.g. https://your-name.ngrok-free.dev/api/slack/callback
SLACK_REDIRECT_URI=

# --- Scheduling ----------------------------------------------------------------
# Max unique recipients accepted in one POST /api/campaigns/schedule request.
MAX_RECIPIENTS_PER_CAMPAIGN=10000

# --- Queue / worker ----------------------------------------------------------
# BullMQ queue name shared by the API (producer) and workers (consumers).
QUEUE_NAME=email-send
# How many jobs ONE worker process handles in parallel.
WORKER_CONCURRENCY=5
# Minimum gap between two sends from the same sender (mimics provider throttling).
MIN_DELAY_BETWEEN_SENDS_MS=2000
# Hard cap on emails per sender per clock hour, enforced in Redis across all workers.
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# Total attempts per email (first try + retries) for real SMTP errors.
JOB_ATTEMPTS=3
# Base delay for exponential retry backoff (5s, 10s, 20s, ...).
JOB_BACKOFF_MS=5000
# A PROCESSING row whose lock is older than this is treated as abandoned (crashed worker).
STALE_LOCK_MS=300000
# Optional global BullMQ limiter: max jobs per GLOBAL_LIMITER_DURATION_MS across ALL workers.
# 0 disables it (per-sender limits above still apply).
GLOBAL_LIMITER_MAX=0
GLOBAL_LIMITER_DURATION_MS=1000

# --- Bull Board (/admin/queues) ----------------------------------------------
# If both are set, the dashboard is protected with HTTP basic auth. Leave empty to disable auth.
BULL_BOARD_USER=admin
BULL_BOARD_PASS=change-me
